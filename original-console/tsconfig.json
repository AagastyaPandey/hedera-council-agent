{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "./hardhat.config.ts",
    "./test/**/*.ts",
    "./packages/**/*.ts",
    "./sentinel/**/*.ts",
    "./scripts/**/*.ts",
    "./intelligence/**/*.ts"
  ],
  "files": ["./hardhat.config.ts"]
}
